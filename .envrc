# NixOS 推荐在 configuration.nix 中启用：
#   programs.direnv.enable = true;
#   programs.direnv.nix-direnv.enable = true;
# 此时走 flake（缓存最好）；未启用 nix-direnv 时退回 direnv 内置的 `use nix`，
# 由仓库根目录 shell.nix 提供同一套环境。
watch_file flake.nix
watch_file flake.lock
watch_file shell.nix
watch_file nix/devshell.nix

if has use_flake 2>/dev/null; then
  use flake
else
  use nix
fi
